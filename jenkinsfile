pipeline {
    agent any

    stages {

        stage('Checkout Code (SCM)') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t total:latest ."
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(['ec2-key']) {
                    sh """
                    ssh ubuntu@172.31.29.207 '
                        docker run -d \
                          --name total \
                          -p 3000:3000 \
                          total:latest
                    '
                    """
                }
            }
        }
    }
}
