pipeline {
    agent any

    environment {
        IMAGE_NAME = "tango"
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/Silentopcode12/Alpha.git'
            }
        }

        stage('Build Image with Tag') {
            steps {
                sh """
                docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                sh """
                export IMAGE_TAG=${IMAGE_TAG}
                docker-compose up -d
                """
            }
        }
    }
}
